    {
        "label": "findonline",
        // "command": "open 'https://duckduckgo.com/\\?q=ducky $ZED_SYMBOL'",
        "command": "python3 -c '\nimport os, re, urllib.parse, subprocess\n\nsel = os.environ.get(\"ZED_SELECTED_TEXT\", \"\").strip()\nif not sel and os.environ.get(\"ZED_FILE\"):\n    try:\n        row = int(os.environ.get(\"ZED_ROW\", 1)) - 1\n        col = int(os.environ.get(\"ZED_COLUMN\", 1)) - 1\n        with open(os.environ[\"ZED_FILE\"]) as f:\n            line = f.readlines()[row]\n        for m in re.finditer(r\"\\w+\", line):\n            if m.start() <= col <= m.end():\n                sel = m.group(0)\n                break\n    except Exception:\n        pass\n\nif sel:\n    url = f\"https://duckduckgo.com/?q=!ducky {urllib.parse.quote(sel)}\"\n    subprocess.run([\"open\", url])\n'",
        "show_command": false,
        "hide": "always",
        "show_summary": false,
        "reveal": "never",
        "use_new_terminal": false,
    },
    {
        "label": "man",
        "command": "python3 -c '\nimport os, re\n\nsel = os.environ.get(\"ZED_SELECTED_TEXT\", \"\").strip()\nif not sel and os.environ.get(\"ZED_FILE\"):\n    try:\n        row = int(os.environ.get(\"ZED_ROW\", 1)) - 1\n        col = int(os.environ.get(\"ZED_COLUMN\", 1)) - 1\n        with open(os.environ[\"ZED_FILE\"]) as f:\n            line = f.readlines()[row]\n        for m in re.finditer(r\"\\w+\", line):\n            if m.start() <= col <= m.end():\n                sel = m.group(0)\n                break\n    except Exception:\n        pass\n\nif sel:\n    os.execvp(\"man\", [\"man\", sel])\nelse:\n    print(\"Nessuna parola trovata sotto il cursore.\")\n'",
