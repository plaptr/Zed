// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    // GLOBAL
    {
        "bindings": {
            "ctrl-o": "pane::GoBack",
            "ctrl-i": "pane::GoForward",
            "ctrl-t": "terminal_panel::Toggle",
        }
    },
    {
        "context": "EmptyPane || Workspace",
        "bindings": {
            "ctrl-o": "pane::GoBack",
            "ctrl-i": "pane::GoForward"
        }
    },
    {
        "context": "VimControl && !menu && vim_mode != operator",
        "bindings": {
            // "w": "vim::NextjubwordStart",
            // "b": "vim::PreviousSubwordStart",
            // "e": "vim::NextSubwordEnd",
            // "g e": "vim::PreviousSubwordEnd",
        },
    },
    {
        "context": "vim_mode == normal || vim_mode == visual",
        "bindings": {
            "r": "vim::HelixJumpToWord",
            "g s": [
                "action::Sequence",
                [
                    "workspace::SaveWithoutFormat",
                    [
                        "task::Spawn",
                        {
                            "task_name": "splitjoin"
                        }
                    ]
                ]
            ]
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            // "shift shift": "file_finder::Toggle"
        },
    },
    {
        "context": "(VimControl && !menu)",
        "bindings": {
            "enter": "editor::OpenExcerpts",
        },
    },
    {
        "context": "Editor && (vim_mode == normal || vim_mode == visual)",
        "bindings": {
            "ctrl-d": [
                "workspace::SendKeystrokes",
                "ctrl-d z z"
            ],
            "ctrl-u": [
                "workspace::SendKeystrokes",
                "ctrl-u z z"
            ],
            "s": "vim::PushAddSurrounds",
            "g r": "editor::FindAllReferences",
            "shift-r": "vim::Exchange",
        },
    },
    {
        "context": "Editor && vim_mode == visual",
        "bindings": {
            "v": "vim::SelectLargerSyntaxNode",
            "s": "vim::PushAddSurrounds",
            "shift-r": "vim::Exchange",
        },
    },
    {
        "context": "vim_operator == a || vim_operator == i || vim_operator == cs || vim_operator == ds || vim_operator == s",
        "bindings": {
            // Traditional Vim behavior
            "Q": "vim::AnyQuotes",
            "B": "vim::AnyBrackets",
            // mini.ai plugin behavior
            "q": "vim::MiniQuotes",
            "b": "vim::MiniBrackets",
        },
    },
    {
        "bindings": {
            "ctrl-l": "workspace::ActivatePaneRight",
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-j": "workspace::ActivatePaneDown",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-/": "terminal_panel::Toggle",
            "ctrl-q": null,
        },
    },
    {
        "context": "(vim_mode == insert && !(showing_code_actions || showing_completions))",
        "bindings": {
            "ctrl-space": "editor::ShowWordCompletions",
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "ctrl-w": null,
            "ctrl-w shift-q": "pane::CloseActiveItem",
            "ctrl-w q": "pane::CloseActiveItem",
            "ctrl-w ctrl-q": "pane::CloseActiveItem",
            "ctrl-w v": "pane::SplitRight",
            "ctrl-w s": "pane::SplitDown",
            "ctrl-w shift-h": "workspace::MovePaneLeft",
            "ctrl-w shift-l": "workspace::MovePaneRight",
            "ctrl-w shift-k": "workspace::MovePaneUp",
            "ctrl-w shift-j": "workspace::MovePaneDown",
            "ctrl-1": [
                "pane::ActivateItem",
                0
            ],
            "ctrl-2": [
                "pane::ActivateItem",
                1
            ],
            "ctrl-3": [
                "pane::ActivateItem",
                2
            ],
            "ctrl-4": [
                "pane::ActivateItem",
                3
            ],
            "ctrl-5": [
                "pane::ActivateItem",
                4
            ],
            "ctrl-6": [
                "pane::ActivateItem",
                5
            ],
            "ctrl-7": [
                "pane::ActivateItem",
                6
            ],
            "ctrl-8": [
                "pane::ActivateItem",
                7
            ],
            "ctrl-9": [
                "pane::ActivateItem",
                8
            ],
            "ctrl-0": "pane::ActivateLastItem",
        },
    },
    {
        // "context": "vim_mode == normal || not_editing || EmptyPane",
        "context": "(Workspace && !Editor && !Terminal) || (Editor && VimControl) || (ProjectPanel && not_editing)",
        "bindings": {
            // MAN
            // "m": [
            //     "action::Sequence",
            //     [
            //         "pane::SplitRight",
            //         [
            //             "task::Spawn",
            //             {
            //                 "task_name": "man"
            //             }
            //         ]
            //     ],
            // ],
            "space l g": [
                "task::Spawn",
                {
                    "task_name": "LazyGit",
                    "reveal_target": "center"
                },
            ],
            "space m": [
                "task::Spawn",
                {
                    "task_name": "findonline"
                }
            ],
            // PICKER
            "space f": "file_finder::Toggle",
            "space /": "pane::DeploySearch",
            "space w": "text_finder::Toggle",
            "space c": "vim::ToggleComments",
            "space C": "vim::ToggleBlockComments",
            "space s": "outline::Toggle",
            "space p": "projects::OpenRecent",
            "space S": "project_symbols::Toggle",
            "space t": "task::Spawn",
            // UI
            "space h": "workspace::CloseAllDocks",
            "space u f": "zed::ToggleFullScreen",
            "space u x": "zed::Extensions",
            // "space u e": "vim::ToggleProjectPanelFocus",
            "space e": "pane::RevealInProjectPanel",
            "space g": "git_panel::ToggleFocus",
            "space d": "diagnostics::Deploy",
            "space G": "debug_panel::ToggleFocus",
            "ctrl-/": "terminal_panel::Toggle",
            "space u c": "agent::ToggleFocus",
            "space o": "outline_panel::Toggle",
            // CODE
            "space a": "editor::ToggleCodeActions",
            "space r": "editor::Rename",
            "space H": "editor::SwitchSourceHeader",
            // DEBUG
            "space G b": "editor::ToggleBreakpoint",
            "space G B": "debugger::ClearAllBreakpoints",
            // "space d c": [
            //     "task::Spawn",
            //     {
            //         "task_name": "Build",
            //     },
            // ],
            "space G d": "debugger::Start",
            "space G s": "debugger::Stop",
            "space G m": "debugger::RunToCursor",
            "space G l": "debugger::Continue",
            "space G p": "debugger::Pause",
        },
    },
    {
        "context": "vim_mode == insert || vim_mode == normal",
        "bindings": {
            "ctrl-s": "editor::ShowSignatureHelp",
        },
    },
]
