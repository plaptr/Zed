// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "selection_highlight": false,
    "word_diff_enabled": true,
    "completion_menu_item_kind": "symbol",
    "edit_predictions": {
        "mode": "eager",
    },
    "scrollbar": {
        "selected_symbol": true,
        "selected_text": true,
        "cursors": true,
        "show": "never",
    },
    "show_completions_on_input": true,
    "completions": {
        "words_min_length": 1,
        "words": "fallback",
    },
    "lsp_document_colors": "inlay",
    "code_lens": "off",
    "show_signature_help_after_edits": true,
    "disable_ai": false,
    "proxy": "",
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
        "opencode": {
            "default_config_options": {
                "mode": "plan",
                "model": "opencode/big-pickle",
            },
            "type": "registry",
        },
        "gemini": {
            "type": "registry",
        },
        "sigit": {
            "default_config_options": {
                "sigit-model": "bartowski/Qwen2.5-3B-Instruct-GGUF",
            },
            "type": "registry",
        },
    },
    "buffer_font_size": 16,
    "agent_ui_font_size": 13,
    "agent_buffer_font_size": 13,
    "ui_font_size": 13,
    "buffer_line_height": {
        "custom": 1.1,
    },
    // "buffer_font_family": ".ZedMono",
    "buffer_font_family": "Liberation Mono",
    "ui_font_family": "Liberation Mono",
    // "buffer_font_family": "JetBrainsMono Nerd Font",
    "terminal": {
        "scrollbar": {
            "show": "auto",
        },
        "toolbar": {
            "breadcrumbs": false,
        },
        "default_height": 720,
        "dock": "bottom",
        "font_size": 14,
        "font_family": "Liberation Mono",
    },
    "which_key": {
        "delay_ms": 0,
        "enabled": true,
    },
    "cli_default_open_behavior": "existing_window",
    "agent": {
        "dock": "right",
        "tool_permissions": {
            "tools": {
                "fetch": {
                    "default": "allow",
                },
                "search_web": {
                    "default": "allow",
                },
            },
        },
        "default_profile": "ask",
        "default_model": {
            "provider": "google",
            "model": "gemini-2.5-flash-lite",
            "enable_thinking": true,
        },
        "favorite_models": [],
        "model_parameters": [],
    },
    "indent_guides": {
        "coloring": "indent_aware",
        "line_width": 1,
        "enabled": false,
    },
    "inlay_hints": {
        "show_value_hints": false,
        "show_background": false,
        "enabled": false,
    },
    "minimap": {
        "show": "never",
    },
    "unnecessary_code_fade": 0.3,
    "telemetry": {
        "diagnostics": true,
        "metrics": false,
        "anthropic_retention": false,
    },
    "enable_language_server": true,
    "lsp_highlight_debounce": 9999999,
    "file_scan_exclusions": [
        // "build/*cmake*",
        // "build/*CMake*",
        // "build/*.ninja*",
        // "dist/**",
        // ".git/**",
        // "**/.DS_Store",
        // "**/.git",
        // "**/.hg",
        // "**/.svn",
        // "**/node_modules",
        // "**/__pycache__",
        // "**/__pycache__/**",
        // "**/*.egg-info",
        // "**/*.egg-info/**",
        // "**/.*.swp",
        // "**/.coverage",
        // "**/.coverage.*",
        // "**/.cache",
        // "**/.pytest_cache",
        // "**/.mypy_cache",
        // "**/.tox",
        // "**/.venv",
        // "**/.virtualenv",
        // "**/.virtualenvs",
        // "**/.env",
        // "**/.direnv",
        // "**/.ipython",
        // "**/.docker"
    ],
    "show_edit_predictions": true,
    "debugger": {
        "dock": "right",
    },
    "collaboration_panel": {
        "dock": "right",
    },
    "outline_panel": {
        "dock": "right",
    },
    "git_panel": {
        "dock": "right",
    },
    "project_panel": {
        "dock": "right",
    },
    "icon_theme": {
        "mode": "light",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme",
    },
    "calls": {
        "mute_on_join": true,
    },
    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },
    "zoomed_padding": true,
    "active_pane_modifiers": {
        "inactive_opacity": 1.0,
    },
    "use_system_window_tabs": false,
    "bottom_dock_layout": "full",
    "tab_bar": {
        "show": false,
    },
    "tabs": {
        "git_status": false,
    },
    "title_bar": {
        "show_project_items": true,
        "show_branch_name": true,
        "show_sign_in": false,
        "show_onboarding_banner": false,
        "show_user_picture": false,
        "show_menus": false,
    },
    "use_smartcase_search": true,
    "diagnostics": {
        "inline": {
            "enabled": true,
        },
    },
    "prettier": {
        "allowed": true,
    },
    "toolbar": {
        "agent_review": true,
        "selections_menu": true,
        "code_actions": true,
        "quick_actions": false,
        "breadcrumbs": true,
    },
    "helix_mode": false,
    "base_keymap": "VSCode",
    "relative_line_numbers": "enabled",
    "soft_wrap": "none",
    "gutter": {
        "min_line_number_digits": 4,
        "breakpoints": false,
        "bookmarks": false,
        "runnables": false,
        "folds": false,
        "line_numbers": true,
    },
    // "cursor_shape": "block",
    "cursor_blink": false,
    "tab_size": 4,
    "vim_mode": true,
    "theme": {
        "mode": "dark",
        "light": "Base16 Atelier Dune Light",
        "dark": "One Dark Pro",
    },
    "vim": {
        "toggle_relative_line_numbers": false,
        "use_system_clipboard": "always",
        "use_smartcase_find": true,
    },
    "format_on_save": "on",
    "formatter": "language_server",
    "languages": {
        "TSX": {
            "formatter": "auto"
        }
    },
    "lsp": {
        "tinymist": {
            "initialization_options": {
                // Enable background preview
                // Server will be running on 127.0.0.1:23635
                "preview": {
                    "invertColors": "always",
                    "background": {
                        "enabled": true,
                    },
                },
            },
            "settings": {
                // Compile on save
                // This will compile a PDF for the `main.typ` file in the project root.
                "exportPdf": "onSave",
                "outputPath": "$root/$name",
                // Enable formatter
                "formatterMode": "typstyle",
            },
        },
        "clangd": {
            "binary": {
                "arguments": [
                    "--header-insertion=never"
                ],
            },
        },
    },
    "colorize_brackets": true,
    "theme_overrides": {
        "One Dark Pro Vivid": {
            "accents": [
                "#ffd700",
                "#c678dd",
                "#61afef"
            ],
            "border": "#3F4350",
            "border.variant": "#3F4350",
            "players": [
                {
                    "cursor": "#D6D6D6"
                }
            ]
        },
        "One Dark Pro": {
            "accents": [
                "#ffd700",
                "#c678dd",
                "#61afef"
            ],
        },
        "Modest Dark": {
            "accents": [
                "#ffd700",
                "#c678dd",
                "#61afef"
            ],
            "editor.active_line.background": "#171C26",
            "search.match_background": "#16A25C",
        },
    },
}
